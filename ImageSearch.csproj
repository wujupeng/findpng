<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>ImageSearch</AssemblyName>
    <RootNamespace>ImageSearch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.6" />
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240508" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240508" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="2.7.0.4" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="2.7.0.4" />
    <PackageReference Include="System.IO.Abstractions" Version="21.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>